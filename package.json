{
  "name": "guesslock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "sync": "tsx --tsconfig tsconfig.json scripts/sync.ts",
    "generate": "tsx --tsconfig tsconfig.json scripts/generate.ts",
    "validate:leaks": "tsx --tsconfig tsconfig.json scripts/validate-leaks.ts",
    "import:voicelines": "tsx --tsconfig tsconfig.json scripts/import-voicelines.ts",
    "make:grain": "node scripts/make-grain.mjs",
    "backup": "tsx --tsconfig tsconfig.json scripts/backup.ts"
  },
  "dependencies": {
    "@neon/config": "^1.8.3",
    "@neon/env": "^1.4.8",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "motion": "^13.4.6",
    "next": "16.3.7",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
