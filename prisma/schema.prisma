// GUESSLOCK data model.
// Game data comes from the Deadlock community API (synced), curation fields are edited in /admin,
// and DailyPuzzle rows freeze everything a puzzle needs so mid-day patches never change it.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SyncRun {
  id            Int       @id @default(autoincrement())
  kind          String // "assets" | "voicelines" | "generate" | "heal"
  status        String // "running" | "ok" | "failed"
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  clientVersion Int?
  counts        Json?
  diff          Json? // { added: [], removed: [], changed: [] }
  issues        Json? // entities excluded because of validation errors, warnings
  error         String?
}

model Hero {
  id         Int     @id // API hero id
  className  String  @unique
  name       String
  active     Boolean @default(true) // present and eligible in the latest sync
  source     Json // normalized API snapshot (see src/lib/deadlock/normalize.ts)
  sourceHash String

  // curation (not in the API)
  species            String? // comma-separated for multi-value, e.g. "Human, Undead"
  releaseDate        DateTime? @db.Date
  genderOverride     String?
  weaponTypeOverride String?
  aliases            String[]
  emojis             String[] // exactly 6, hardest first
  emojisReviewed     Boolean   @default(false)
  genericVoice       Boolean   @default(false)
  genericVoiceManual Boolean   @default(false) // true when an admin set genericVoice by hand
  voiceImportedAt    DateTime?
  voiceRevisionId    Int?
  excludeFromModes   String[]
  setup              Json? // per-mode puzzle setup overrides (see src/lib/admin/setup.ts)
  attrs              Json? // category values: overrides of API columns and custom categories (see engine/columns.ts)
  needsReview        Boolean   @default(true)
  reviewReasons      String[]

  firstSeenAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  removedAt   DateTime?

  abilities  Ability[]
  voiceLines VoiceLine[]
  soundMap   HeroSoundMap?
}

model Ability {
  id               BigInt   @id
  className        String   @unique
  name             String
  heroId           Int
  hero             Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  slot             Int // 1-3 regular, 4 = ultimate
  active           Boolean  @default(true)
  source           Json
  sourceHash       String
  aliases          String[]
  excludeFromModes String[]
  needsReview      Boolean  @default(false)
  reviewReasons    String[]
  updatedAt        DateTime @updatedAt
}

model Item {
  id               BigInt   @id
  className        String   @unique
  name             String
  active           Boolean  @default(true)
  source           Json
  sourceHash       String
  aliases          String[]
  excludeFromModes String[]
  attrs            Json? // category values: overrides of API columns and custom categories
  needsReview      Boolean  @default(false)
  reviewReasons    String[]
  firstSeenAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Redacted / rewritten texts for Lore, Ability Description and Upgrade Guesser.
// sourceText is the rendered API text; finalText is what players see once approved.
// Attribute categories (columns) of The Reckoning (entity "hero") and The Appraisal ("item").
// Built-in columns are defined in src/lib/engine/columns.ts; a row here only overrides their label,
// info, order and on/off state. Custom categories exist only here; their values live in Hero/Item.attrs.
model Category {
  key       String   @id // "<entity>.<column key>", e.g. "hero.role"
  entity    String // "hero" | "item"
  label     String
  info      String   @default("")
  type      String // "exact" | "multi" | "numeric" | "date"
  unit      String   @default("") // numeric suffix, e.g. "cm"
  builtin   Boolean  @default(false)
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model TextEntry {
  id         Int      @id @default(autoincrement())
  entityType String // "hero_lore" | "ability_desc" | "ability_t1" | "ability_t2" | "ability_t3"
  entityId   BigInt
  sourceText String
  sourceHash String
  autoText   String // automatic redaction of sourceText
  finalText  String?
  status     String   @default("auto") // "auto" (needs review) | "approved" | "rewritten"
  stale      Boolean  @default(false) // source changed after approval
  updatedAt  DateTime @updatedAt

  @@unique([entityType, entityId])
}

model VoiceLine {
  id             Int      @id @default(autoincrement())
  heroId         Int
  hero           Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  wikiPage       String
  revisionId     Int
  section        String
  fileName       String
  sourceText     String
  sourceHash     String
  text           String? // manual edit / redaction; null = use autoText
  autoText       String // automatic redaction of sourceText
  wordCount      Int
  audioUrl       String? // resolved wiki file URL; mirrored when a puzzle uses the line
  audioAssetId   String?
  status         String // "approved" | "excluded" | "needs_redaction" | "needs_review"
  autoReason     String?
  starred        Boolean  @default(false)
  manuallyEdited Boolean  @default(false)
  sourceChanged  Boolean  @default(false)
  importedAt     DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([heroId, fileName])
}

// ───────────── The Resonance (ability sounds from deadlock-api's sound index) ─────────────

// Which sound-index folders belong to a hero. Lists, because some heroes have two
// (Lady Geist: ghost + geist, Pocket: synth + pocket). See docs/resonance-data-spike.md.
model HeroSoundMap {
  heroId         Int      @id
  hero           Hero     @relation(fields: [heroId], references: [id], onDelete: Cascade)
  abilityFolders String[] // under abilities/
  weaponFolders  String[] // under weapons/
  source         String   @default("auto") // "auto" | "manual" (manual mappings are never overwritten)
  updatedAt      DateTime @updatedAt
}

// One clip from the sound index. The automatic pass suggests; only "approved" clips are ever used.
model SoundClip {
  id         Int       @id @default(autoincrement())
  sourceUrl  String    @unique // CDN URL (never sent to players: it contains the codename)
  sourcePath String // index path without extension, e.g. abilities/haze/haze_sleep_dagger_cast
  heroId     Int?
  abilityId  BigInt?
  kind       String // "ability" | "weapon"
  role       String // "cast" | "impact" | "loop" | "other"
  score      Float     @default(0) // automatic match score
  status     String    @default("suggested") // "suggested" | "approved" | "excluded"
  autoReason String? // why the automatic pass excluded it
  preferred  Boolean   @default(false) // "prefer as clip 1" (or as the gun clip)
  manual     Boolean   @default(false) // an admin changed status/role/ability: re-imports keep them
  changed    Boolean   @default(false) // source changed after approval (review queue)
  missing    Boolean   @default(false) // gone from the index; the mirrored copy keeps working
  durationMs Int?
  peakDb     Float?
  loudnessDb Float?
  gainDb     Float?
  assetId    String? // MirroredAsset id (served as /media/<assetId>)
  sourceHash String? // CDN ETag
  importedAt DateTime  @default(now())
  measuredAt DateTime?
  updatedAt  DateTime  @updatedAt

  @@index([heroId, status])
  @@index([abilityId, status])
}

// Mirrored images/audio so puzzles survive upstream URL changes. Served from /media/[id].
model MirroredAsset {
  id          String   @id // sha1 of the source url
  sourceUrl   String   @unique
  contentType String
  bytes       Bytes
  byteSize    Int
  fetchedAt   DateTime @default(now())
}

model DailyPuzzle {
  id           Int      @id @default(autoincrement())
  date         String // YYYY-MM-DD in the puzzle timezone
  mode         String // lock slug
  answerId     String // what the no-repeat window keys on
  payload      Json // frozen snapshot of everything the puzzle displays and checks
  dataVersion  Int?
  sealed       Boolean  @default(false)
  sealedReason String?
  overridden   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([date, mode])
  @@index([mode, date])
}

// Last good response of every external API call the app depends on, so puzzle generation keeps
// working through an upstream outage (see src/lib/deadlock/snapshots.ts and `npm run backup`).
model ApiSnapshot {
  key       String   @id // stable name, e.g. "assets-heroes", "analytics-item-stats"
  url       String
  data      Json
  byteSize  Int
  fetchedAt DateTime
}

// ───────────── The Omens ─────────────

// A match harvested for Omen scenarios: replay queries in flight, then the compressed timeline.
model OmenMatch {
  matchId     BigInt     @id
  status      String // "queued" | "fetching" | "ready" | "failed" | "rejected"
  source      String // "daily" | "practice" | "mine"
  priority    Int        @default(0)
  rank        Int?
  startTime   DateTime?
  jobs        Json? // { players: { id, status }, world: …, events: … }
  submittedAt DateTime?
  timelineGz  Bytes? // gzip(JSON MatchTimeline); pruned after OMEN_TIMELINE_DAYS
  error       String?
  requestedBy String? // sha1 of the requester's IP (practice "My matches" rate limit)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  scenarios   Scenario[]

  @@index([status, priority])
}

// A frozen moment T in a match. payload = OmenPayload (snapshot, window, answer).
model Scenario {
  id        String    @id // `${matchId}-${omen}-${t}`
  omen      String // "clash" | "beast" | "rift"
  matchId   BigInt
  match     OmenMatch @relation(fields: [matchId], references: [matchId], onDelete: Cascade)
  t         Int
  window    Int
  positive  Boolean
  quality   Float
  source    String // "daily" | "practice" | "mine"
  rank      Int
  patch     String? // match day (YYYY-MM-DD), used as the patch label
  status    String    @default("candidate") // "candidate" | "approved" | "rejected" | "used"
  dailyDate String? // set when frozen into a DailyPuzzle
  payload   Json
  createdAt DateTime  @default(now())

  @@index([omen, source, status])
  @@index([dailyDate])
}

// Player reports from /feedback: a bug in one puzzle ("bug": date + lock), or a wrong data value ("data": an entity, the field
// and optionally the right value). Reviewed in /admin/feedback.
model Feedback {
  id           Int      @id @default(autoincrement())
  kind         String // "bug" | "data"
  date         String? // bug: puzzle day (YYYY-MM-DD)
  lock         String? // bug: lock slug
  entity       String? // data: "hero" | "item" | "ability"
  entityId     Int?
  entityName   String?
  field        String? // data: category key, or "other"
  fieldLabel   String?
  currentValue String? // what the reporter saw
  suggested    String? // the reporter's fix, optional
  description  String   @default("")
  page         String? // where the report was started
  userId       String? // signed-in reporter
  status       String   @default("open") // "open" | "fixed" | "dismissed"
  adminNote    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
}

// Small admin-edited settings by key, e.g. "weapon-groups" (weapon type -> Reckoning weapon family, see engine/columns.ts).
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Admin-editable detection tuning (overrides DEFAULT_TUNING in src/lib/omens/scenario.ts).
model OmenConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ───────────── Accounts (identity lives in Neon Auth's neon_auth schema) ─────────────

model Profile {
  userId       String     @id // neon_auth user id
  displayName  String
  nameKey      String     @unique // lowercased displayName, for case-insensitive uniqueness
  showOnBoards Boolean    @default(true)
  /// The Black Market: equipped cosmetics (keys from src/lib/market/catalog.ts; null = none).
  equippedTitle String?
  equippedColor String?
  equippedTheme String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  plays        Play[]
  stats        UserStats?
  wallet       Wallet?
  items        InventoryItem[]
}

// One player's attempt at one lock on one day, recorded by the server.
model Play {
  id           Int       @id @default(autoincrement())
  userId       String
  profile      Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  date         String // puzzle day (YYYY-MM-DD)
  lock         String // lock slug
  guesses      String[]
  bonus        String?
  status       String // "playing" | "won" | "lost"
  hintsUsed    Int       @default(0)
  noHints      Boolean   @default(false)
  souls        Int       @default(0)
  bonusCorrect Boolean   @default(false)
  hard         Boolean   @default(false) // played in hard mode (fixed by the first guess)
  omen         Json? // The Omens: the locked-in answers (souls = the Omen score)
  archive      Boolean   @default(false) // replay of a past day
  // "live": played guess by guess while signed in (counts for leaderboards)
  // "import": brought in from a device's local history (personal stats only)
  source       String    @default("live")
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt

  @@unique([userId, date, lock])
  @@index([date, source, archive])
}

// Denormalized per-user totals for leaderboards, recomputed when a ranked play finishes.
model UserStats {
  userId        String   @id
  profile       Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  totalSouls    Int      @default(0)
  daysUnlocked  Int      @default(0)
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  lastDay       String? // last day with a ranked win
  updatedAt     DateTime @updatedAt
}

// ───────────── The Séance (hero grouping puzzle) ─────────────

// A set over all active heroes (not a list of examples). Usable for boards only when approved and
// complete: every active hero has an explicit membership row (a missing row means "unknown").
model SeanceCategory {
  id          Int                @id @default(autoincrement())
  key         String?            @unique // stable id of API-derived categories, e.g. "api:hero_type:marksman"
  /// Which entity the group is about: "hero" | "item" | "ability" (the Séance, the Bazaar, the Grimoire).
  entity      String             @default("hero")
  type        String // heroes: "mechanics" | "visuals" | "lore"; items: "stats" | "effects" | "visuals"; abilities: "mechanics" | "effects" | "visuals"
  label       String // shown once the group is solved
  explanation String?
  source      String // "api" | "derived" | "curated"
  difficulty  Int                @default(2) // 1 = obvious … 4 = devious
  status      String             @default("draft") // "draft" | "approved" | "retired"
  flagged     Boolean            @default(false) // membership changed in a sync: review it
  flagReason  String?
  diff        Json? // last sync change: { added: heroId[], removed: heroId[], at }
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  memberships SeanceMembership[]

  @@index([type, status])
  @@index([entity, type, status])
}

model SeanceMembership {
  categoryId Int
  category   SeanceCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Hero, item or ability id (ability and item ids exceed 32 bits).
  entityId   BigInt
  member     Boolean
  source     String // "api" | "derived" | "curated" | "admin" | "agent"
  updatedAt  DateTime       @updatedAt

  @@id([categoryId, entityId])
  @@index([entityId])
}

// ───────────── The Echo family (select lines, ability cast lines, conversations) from the wiki ─────────────

// One row per voice entry of a hero's wiki voice-line page. `kind`: "select" (a Select line), "cast"
// (a line when casting an ability: abilityId/abilitySlot set) or "convo" (a complete conversation: `lines`).
model VoiceEntry {
  id          Int      @id @default(autoincrement())
  heroId      Int
  kind        String
  fileKey     String // wiki file name (select/cast) or the conversation's first file: unique per hero
  abilityId   BigInt?
  abilitySlot Int?
  otherHeroId Int? // conversations: the hero on the other side
  /// Select/cast: the line with this hero's own names already blacked out.
  text        String?
  /// Conversations: [{ "h": heroId, "t": text }] in order; this hero's names are blacked out.
  lines       Json?
  status      String   @default("approved") // "approved" | "excluded"
  importedAt  DateTime @default(now())

  @@unique([heroId, kind, fileKey])
  @@index([heroId, kind, status])
}

// ───────────── Endless mode (practice puzzles on demand) ─────────────

// One practice puzzle, built on request and frozen like a DailyPuzzle. `id` is a random 128-bit token: knowing it is
// what lets a browser play it (the payload never leaves the server). Pruned after ENDLESS_TTL_DAYS.
model EndlessPuzzle {
  id        String   @id
  lock      String // lock slug
  answerId  String
  payload   Json
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ───────────── The Black Market (spending souls on cosmetics) ─────────────

// Spendable souls = UserStats.totalSouls (earned, what the leaderboards rank) + Wallet.adjust (spent < 0, refunds and
// trades). Updated with a conditional UPDATE so a balance can never go below zero, even with parallel requests.
model Wallet {
  userId    String   @id
  profile   Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  adjust    Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Every change to Wallet.adjust, for the player's history and for support.
model SoulLedger {
  id        Int      @id @default(autoincrement())
  userId    String
  delta     Int
  reason    String // "case" | "duplicate" | "trade-out" | "trade-in"
  ref       String? // case id, trade id
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// One owned cosmetic (an instance, so it can change hands in a trade).
model InventoryItem {
  id         Int      @id @default(autoincrement())
  userId     String
  profile    Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  itemKey    String
  source     String // "case" | "trade"
  obtainedAt DateTime @default(now())

  @@index([userId])
  @@index([userId, itemKey])
}

// A trade offer between two players: items and/or souls each way. Accepting moves everything in one transaction.
model TradeOffer {
  id         Int       @id @default(autoincrement())
  fromUser   String
  toUser     String
  giveItems  Int[] // InventoryItem ids owned by fromUser
  giveSouls  Int       @default(0)
  wantItems  Int[] // InventoryItem ids owned by toUser
  wantSouls  Int       @default(0)
  message    String?
  status     String    @default("open") // "open" | "accepted" | "declined" | "cancelled" | "failed"
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([toUser, status])
  @@index([fromUser, status])
}

// Shared rate-limit counters across server instances (the sensitive, low-volume endpoints). Rows are pruned daily.
model RateLimit {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}
