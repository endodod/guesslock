# Postgres (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Player accounts (self-hosted Better Auth, src/lib/auth/). Accounts are off without the secret (32+ random characters).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="https://guesslock.paulkuehn.ch"   # this site's origin (http://localhost:3000 in development)
# Emails (sign-in codes, password reset links) through Resend. Unset: nothing is sent, the message is logged instead.
RESEND_API_KEY=""
MAIL_FROM="GUESSLOCK <noreply@guesslock.paulkuehn.ch>"   # a sender on a domain verified in Resend
# Optional: Steam Web API key, so new Steam players are named after their Steam profile (otherwise "Steam 12345").
STEAM_API_KEY=""
# Only to keep invite links made before the move to Better Auth valid when SESSION_SECRET is unset (see src/lib/market/earn.ts).
# NEON_AUTH_COOKIE_SECRET=""

# Admin (/admin): password + a random secret (32+ chars) for signing the session cookie
ADMIN_PASSWORD=""
SESSION_SECRET=""
# 1 = enable /admin/setup: per-hero, per-puzzle setup editing (modes on/off, clue texts, emojis, voice lines, build items).
ADMIN_SETUP_MODE=""
# 1 = show an "Admin login" button under the sign-in form (local debugging only).
ADMIN_DEBUG=""

# Cron endpoints (/api/cron/*) require: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# Agent API (/api/agent/v1/*): 32+ char bearer tokens for reading and editing puzzle state
AGENT_API_READ_TOKEN=""
AGENT_API_WRITE_TOKEN=""
# 1 = allow agents to approve Séance categories; default is 0 (drafts only)
# AGENT_API_ALLOW_APPROVE=""

# Optional: Discord/Slack-compatible webhook for sync failures / days without puzzles
ALERT_WEBHOOK_URL=""

# Game settings
PUZZLE_TIMEZONE="Europe/Zurich"
PUZZLE_SALT="guesslock-v1"      # changing it reshuffles future puzzles. The default is public: set a private one in production,
                                # or anyone with the source can work out upcoming puzzles (days already generated stay as they are)
LAUNCH_DATE="2026-10-01"        # puzzle #1
SITE_URL="guesslock.paulkuehn.ch"

# Optional tuning (defaults shown)
# TRUSTED_PROXY_HOPS=1    # reverse proxies in front of the app (Vercel: 1). 0 when it is reachable directly: forwarding headers are then ignored
# DB_POOL_MAX=10          # database connections per server instance
# GENERATE_DAYS_AHEAD=7
# MAX_NO_REPEAT_DAYS=60
# ANALYTICS_DAYS=21
# ANALYTICS_MIN_BADGE=70
# EXCLUDED_ITEM_TIERS=5
# API_BACKUP_MAX_DAYS=14

# The Omens: optional deadlock-api key (raises replay queries from 20/h to 200/h)
# DEADLOCK_API_KEY=""
# OMEN_QUERIES_PER_HOUR=18
# OMEN_TIMELINE_DAYS=14
# OMEN_MATCH_URL="https://statlocker.gg/match/{id}"
