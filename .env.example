# Postgres (Neon). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=verify-full"

# Player accounts (Neon Auth). NEON_AUTH_BASE_URL is written by `neon deploy` / `neon env pull`
# (neon.ts declares `auth: true`); the cookie secret is yours: 32+ random characters.
NEON_AUTH_BASE_URL="https://ep-....neonauth.REGION.aws.neon.tech/neondb/auth"
NEON_AUTH_COOKIE_SECRET=""

# Admin (/admin): password + a random secret (32+ chars) for signing the session cookie
ADMIN_PASSWORD=""
SESSION_SECRET=""

# Cron endpoints (/api/cron/*) require: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""

# Optional: Discord/Slack-compatible webhook for sync failures / days without puzzles
ALERT_WEBHOOK_URL=""

# Game settings
PUZZLE_TIMEZONE="Europe/Zurich"
PUZZLE_SALT="guesslock-v1"      # changing it reshuffles all future puzzles
LAUNCH_DATE="2026-10-01"        # puzzle #1
SITE_URL="guesslock.paulkuehn.ch"

# Optional tuning (defaults shown)
# GENERATE_DAYS_AHEAD=7
# MAX_NO_REPEAT_DAYS=60
# ANALYTICS_DAYS=21
# ANALYTICS_MIN_BADGE=70
# EXCLUDED_ITEM_TIERS=5
